        <!-- Hook (Exit) → Tools -->
        <mxCell id="arrow-p1-hook2tool1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FF9800;endArrow=classic;endFill=1;" edge="1" parent="1" source="hook-p1-exit" target="tool-jira-p1">
