        <!-- Layer Transitions -->
        <mxCell id="arrow-strategy-design" value="LAYER TRANSITION&#10;Strategy → Design" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=6;strokeColor=#FF6F00;endArrow=classic;endFill=1;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="phases-strategy-continue" target="phases-design-layer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="arrow-design-execution" value="LAYER TRANSITION&#10;Design → Execution" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=6;strokeColor="#FF6F00;endArrow=classic;endFill=1;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="phases-design-layer" target="phases-execution-layer">
          <mxGeometry relative="1" as="geometry"/>
