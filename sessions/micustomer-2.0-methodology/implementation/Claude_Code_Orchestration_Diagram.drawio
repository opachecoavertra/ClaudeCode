        <!-- Phase 1 → Phases 2-4 -->
        <mxCell id="arrow-p1-p2" value="CONTINUE STRATEGY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=5;strokeColor=#FF6F00;endArrow=classic;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="agent-p1-monitor" target="phases-strategy-continue">
          <mxGeometry relative="1" as="geometry"/>
